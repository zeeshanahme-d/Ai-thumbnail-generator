# Base URL of the Express API (defaults to http://localhost:8000 when unset)
VITE_API_BASE_URL=http://localhost:8000

# Public origin of the site, used for the social preview tags in index.html (no trailing slash)
VITE_SITE_URL=http://localhost:5173

# Paddle client-side token (test_... in sandbox), safe to expose. From Paddle > Developer tools > Authentication.
VITE_PADDLE_CLIENT_TOKEN=
# "production" for live payments; anything else uses the Paddle sandbox.
VITE_PADDLE_ENV=sandbox
