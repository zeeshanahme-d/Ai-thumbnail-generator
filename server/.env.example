ISSUER_BASE_URL=
CLIENT_ID=
SECRET=
BASE_URL=
CLIENT_URL=
PORT=
JWT_EXPIRES_IN=
MONGO_DB_URL=

CLOUDINARY_URL=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_NAME=

GEMINI_API_KEY=

# Number of reverse proxies in front of the API (usually 1 on Render, Railway or behind Nginx).
# Leave empty when clients connect directly. Rate limits rely on it to see real client IPs.
TRUST_PROXY=

# Paddle Billing. PADDLE_ENV=production for live; anything else uses the sandbox.
PADDLE_ENV=sandbox
# Server-side API key (pdl_sdbx_apikey_... in sandbox) from Paddle > Developer tools > Authentication.
PADDLE_API_KEY=
# Secret of the notification destination that points at POST /billing/webhook.
PADDLE_WEBHOOK_SECRET=
PADDLE_PRODUCT_PRO=
PADDLE_PRODUCT_ULTRA=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_ULTRA_MONTHLY=
PADDLE_PRICE_ULTRA_YEARLY=

# Lowest level printed: debug, info, warn or error. Defaults to info in production, debug locally.
LOG_LEVEL=
