# Signs access tokens. Required.
SECRET=
# Signs refresh tokens. Required, and must differ from SECRET.
REFRESH_SECRET=
# The website's public origin, e.g. https://eyecatch.zeeshanahmed.dev (comma-separate several;
# the first is where share links redirect). Required in production. Only these origins pass
# CORS and may send writes; http://localhost:5173 and :5174 are added outside production.
# Auth cookies are SameSite=Strict, so the site and the API must share a registrable domain
# (eyecatch.zeeshanahmed.dev + api.eyecatch.zeeshanahmed.dev do).
CLIENT_URL=
PORT=
# Required.
MONGO_DB_URL=
# production turns on Secure cookies and hides 5xx error details from clients.
NODE_ENV=

CLOUDINARY_URL=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_NAME=

GEMINI_API_KEY=

# Verification and password-reset emails. SMTP_USER is also the sender address.
# SMTP_TLS_PORT defaults to 587; 465 connects over TLS from the start.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_PORT=

# Number of reverse proxies in front of the API: 1 for Nginx/Caddy on the Oracle instance,
# 2 if Cloudflare proxies in front of that. Leave empty only when clients connect to Node
# directly. Rate limits rely on it to see real client IPs; production warns when it is empty.
TRUST_PROXY=

# Paddle Billing. PADDLE_ENV=production for live; anything else uses the sandbox.
PADDLE_ENV=sandbox
# Server-side API key (pdl_sdbx_apikey_... in sandbox) from Paddle > Developer tools > Authentication.
PADDLE_API_KEY=
# Secret of the notification destination that points at POST /billing/webhook.
PADDLE_WEBHOOK_SECRET=
# Catalog IDs below are the sandbox ones (not secret). Live has its own IDs: replace them for production.
PADDLE_PRODUCT_PRO=pro_01m5583515j4qjs5ftpbxmt6j6
PADDLE_PRODUCT_ULTRA=pro_01m55836jf1y6ja060vc2vr1q5
PADDLE_PRICE_PRO_MONTHLY=pri_01m558359vavtra7m0xrmrkczs
PADDLE_PRICE_PRO_YEARLY=pri_01m5583685wvet95ncya79tq3r
PADDLE_PRICE_ULTRA_MONTHLY=pri_01m55836v08r19h84eje3he68q
PADDLE_PRICE_ULTRA_YEARLY=pri_01m558373ahvdyyjx8kf4r581d
# One-time credit pack: USD 0.25 per unit of 5 credits, 5–500 units (25 to 2,500 credits).
PADDLE_PRODUCT_CREDITS=pro_01m55k2h4jy2pjv94arg9xn7yc
PADDLE_PRICE_CREDITS=pri_01m55k2hcxdcyj1m1fbk3w9e81
